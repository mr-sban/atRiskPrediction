# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ============================================================
# Virtual environments
# ============================================================
.venv/
venv/
env/
ENV/
.python-version

# ============================================================
# Jupyter / jupytext
# ============================================================
# The .py files with # %% cells are the source of truth.
# Any generated .ipynb is a build artifact of `jupytext --to ipynb`.
.ipynb_checkpoints/
*.ipynb
!notebooks/**/*.ipynb.bak   # keep jupytext backups if you use them

# ============================================================
# Data (regenerable / large — do not commit)
# ============================================================
# OULAD source CSVs — download from the OU repository (see README).
data/raw/*
!data/raw/.gitkeep

# Engineered features — regenerate by running
# notebooks/03_feature_engineering.py.
data/processed/*
!data/processed/.gitkeep

# Never commit anything with these extensions anywhere in the tree.
*.parquet
*.feather
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.sqlite
*.db

# ============================================================
# Models and experiment artefacts (Week 11+)
# ============================================================
models/
runs/
*.onnx
mlruns/
lightning_logs/

# ============================================================
# Environment / secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Logs / temporary
# ============================================================
*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# ============================================================
# IDE / editor
# ============================================================
.idea/
*.swp
*.swo

# VSCode: ignore workspace files, but allow shared settings.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
